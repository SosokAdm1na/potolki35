---
import '../styles/global.css';
import { site } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import LeadModal from '../components/LeadModal.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown>;
}
const { title, description, image, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const mirror = import.meta.env.PUBLIC_MIRROR === '1';
const metrika = `(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js?id=${site.metrika}','ym');ym(${site.metrika},'init',{ssr:true,clickmap:true,referrer:document.referrer,url:location.href,trackLinks:true,accurateTrackBounce:true});`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.name,
  telephone: site.phone,
  url: site.url,
  areaServed: site.city,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'RU' },
  openingHours: 'Mo-Su 09:00-21:00',
  priceRange: '₽₽',
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {mirror && <meta name="robots" content="noindex, nofollow" />}
    {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f4f2ee" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, site.url).href} />}
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    {site.metrika > 0 && !mirror && <script is:inline set:html={metrika} />}
  </head>
  <body class="min-h-dvh">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <LeadModal />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
