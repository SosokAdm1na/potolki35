---
import { site } from '../config';
import Icon from './Icon.astro';
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/90 px-3 pb-[max(env(safe-area-inset-bottom),12px)] pt-3 backdrop-blur-xl md:hidden">
  <div class="grid grid-cols-[auto_1fr] gap-2">
    <a href={site.phoneHref} class="btn-ghost !px-5" aria-label="Позвонить" data-goal="phone_click">
      <Icon name="phone" /> Позвонить
    </a>
    <button type="button" class="btn-primary" data-open-lead data-lead-source="Нижняя панель (моб.)">
      Замер бесплатно
    </button>
  </div>
</div>
