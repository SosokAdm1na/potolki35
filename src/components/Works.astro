---
import { Image } from 'astro:assets';
import { works } from '../data/works';
import Icon from './Icon.astro';
interface Props { limit?: number; bare?: boolean }
const { limit = 6, bare = false } = Astro.props;
const list = works.slice(0, limit);
---
<section class:list={['sec', bare && '!pt-0']}>
  <div class="container-x">
    {!bare && (
      <div class="sec-head flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Портфолио</p>
          <h2 class="h2 mt-3">Наши работы</h2>
        </div>
        <a href="/raboty/" class="group inline-flex items-center gap-2 font-medium">Смотреть все <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" /></a>
      </div>
    )}

    <div class:list={['sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 lg:grid-cols-3', bare ? 'grid gap-4' : '-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4']}>
      {list.map((w, i) => (
        <figure class:list={['reveal group relative overflow-hidden rounded-4xl', !bare && 'w-[82%] shrink-0 snap-start sm:w-auto']} style={`transition-delay:${(i % 3) * 80}ms`}>
          <Image src={w.photo} alt={w.title} widths={[480, 800]} sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 82vw" class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-105" />
          <figcaption class="absolute inset-x-3 bottom-3 rounded-3xl bg-ink/70 p-4 text-white backdrop-blur-md">
            <p class="font-medium">{w.title}</p>
            <p class="mt-1 text-xs text-white/70">{w.type}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
