---
import { Image } from 'astro:assets';
import { site } from '../config';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import photo from '../assets/hero/stone.jpg';
interface Props { source?: string }
const { source = 'Форма внизу страницы' } = Astro.props;
---
<section id="zayavka" class="sec">
  <div class="container-x">
    <div class="grid overflow-hidden rounded-[2.5rem] bg-surface lg:grid-cols-2">
      <div class="relative hidden min-h-[560px] lg:block">
        <Image src={photo} alt="Подсветка потолка над каменной стеной" widths={[720]} sizes="50vw" class="absolute inset-0 size-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent"></div>
        <div class="absolute inset-x-8 bottom-8 text-white">
          <ul class="flex flex-col gap-3">
            {['Замер и смета бесплатно', 'Монтаж за 1 день', `Скидка ${site.discountPercent}% по заявке с сайта`].map((t) => (
              <li class="flex items-center gap-3"><span class="grid size-7 place-items-center rounded-full bg-glow text-ink"><Icon name="check" class="size-4" /></span>{t}</li>
            ))}
          </ul>
        </div>
      </div>
      <div class="p-6 sm:p-10 lg:p-12">
        <span class="inline-flex rounded-full bg-glow px-3 py-1 text-xs font-bold">−{site.discountPercent}% по заявке с сайта</span>
        <h2 class="h2 mt-4">Закажите бесплатный замер</h2>
        <p class="mb-8 mt-3 text-muted">Оставьте телефон. Если заполните детали, менеджер позвонит уже с примерным расчётом.</p>
        <LeadForm id="cta" source={source} />
      </div>
    </div>
  </div>
</section>
