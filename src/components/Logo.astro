---
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', dark ? 'text-white' : 'text-ink']}>
  <span class="relative grid size-9 place-items-center overflow-hidden rounded-xl bg-ink ring-1 ring-white/10">
    <span class="absolute inset-x-1.5 top-2 h-[2px] rounded-full bg-glow shadow-[0_0_10px_2px_rgba(255,181,71,.8)]"></span>
    <span class="mt-2 font-display text-[13px] font-semibold text-white">35</span>
  </span>
  <span class="font-display text-[17px] font-semibold tracking-tight">Потолки<span class="text-glow">35</span></span>
</span>
