---
// Знак: цифры 35 «подвешены» к одной световой линии — как свет в натяжном потолке.
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<span class:list={['flex items-center gap-2.5', dark ? 'text-white' : 'text-ink']}>
  <svg class="size-10 shrink-0" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <rect x=".5" y=".5" width="39" height="39" rx="10.5" fill="#0f0f11" stroke={dark ? '#ffffff2e' : '#0f0f11'} />
    <rect x="4.5" y="6.6" width="31" height="6.8" rx="3.4" fill="#ffb547" opacity=".2" />
    <path d="M17.2 10.4l-4.4 6c3.6-.4 6.2 1.6 6.2 4.8 0 3.2-2.5 5.6-5.8 5.6-2.3 0-4.2-1-5.2-2.9" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M23.8 10.4l-1 7c1-.6 2.1-.9 3.3-.9 3.2 0 5.5 2.2 5.5 5.2s-2.4 5.1-5.6 5.1c-2.1 0-3.8-.8-4.8-2.5" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M6.5 10h27" stroke="#ffb547" stroke-width="3" stroke-linecap="round" />
  </svg>
  <span class="font-display text-[17px] font-semibold tracking-tight">Потолки<span class:list={[dark ? 'text-glow' : 'text-glow-deep']}>35</span></span>
</span>
