---
import { reviews } from '../data/reviews';
import Icon from './Icon.astro';
---
{reviews.length > 0 && (
  <section class="sec overflow-hidden" data-reviews>
    <div class="container-x">
      <div class="sec-head flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Отзывы</p>
          <h2 class="h2 mt-3">Что пишут клиенты</h2>
        </div>
        <div class="hidden shrink-0 gap-2 sm:flex">
          <button type="button" class="grid size-11 rotate-180 place-items-center rounded-full border border-line transition hover:border-ink" data-reviews-prev aria-label="Предыдущие отзывы"><Icon name="arrow" class="size-4" /></button>
          <button type="button" class="grid size-11 place-items-center rounded-full border border-line transition hover:border-ink" data-reviews-next aria-label="Следующие отзывы"><Icon name="arrow" class="size-4" /></button>
        </div>
      </div>
      <div class="review-track -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0" data-reviews-track tabindex="0" aria-label="Отзывы клиентов">
        {reviews.map((r) => (
          <blockquote class="flex w-[86%] shrink-0 snap-start flex-col gap-5 rounded-4xl border border-line bg-surface p-6 sm:w-[46%] sm:p-7 lg:w-[calc((100%-2rem)/3)]">
            <p class="flex-1 leading-relaxed">{r.text}</p>
            <footer class="flex items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-ink font-display font-medium text-glow">{r.name[0].toUpperCase()}</span>
              <span class="min-w-0">
                <b class="block font-semibold">{r.name}</b>
                {(r.where || r.date) && <span class="block truncate text-sm text-muted">{[r.where, r.date].filter(Boolean).join(' · ')}</span>}
              </span>
              {r.source && (r.url
                ? <a href={r.url} target="_blank" rel="noopener" class="ml-auto shrink-0 text-xs font-medium text-muted underline underline-offset-2 hover:text-ink">{r.source}</a>
                : <span class="ml-auto shrink-0 text-xs font-medium text-muted">{r.source}</span>)}
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((box) => {
    const track = box.querySelector<HTMLElement>('[data-reviews-track]')!;
    const step = (dir: number) => {
      const card = track.firstElementChild as HTMLElement;
      track.scrollBy({ left: dir * (card.offsetWidth + 16), behavior: 'smooth' });
    };
    box.querySelector('[data-reviews-prev]')?.addEventListener('click', () => step(-1));
    box.querySelector('[data-reviews-next]')?.addEventListener('click', () => step(1));
  });
</script>
