---
import Icon from './Icon.astro';
const faq = [
  { q: 'Сколько длится монтаж?', a: 'Обычную квартиру делаем за один день. Световые линии могут занять больше, срок скажем на замере.' },
  { q: 'Нужно ли выносить мебель?', a: 'Обычно нет. Нужен свободный доступ к стенам: мебель отодвигаем и накрываем плёнкой.' },
  { q: 'Будет ли запах?', a: 'Лёгкий запах после монтажа возможен. Он уходит за пару дней, если проветривать комнату.' },
  { q: 'Что будет, если затопят соседи?', a: 'ПВХ-полотно обычно удерживает воду. Не прокалывайте его и позвоните нам: приедем и сольём воду.' },
  { q: 'Как считается цена?', a: 'Калькулятор показывает примерную сумму. Точную смету замерщик считает на месте: она зависит от площади, формы комнаты, профиля и количества светильников.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<section class="sec">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <p class="eyebrow">Вопросы</p>
      <h2 class="h2 mt-3">Частые вопросы</h2>
      <p class="mt-4 max-w-sm text-muted">Не нашли ответ? Позвоните или оставьте заявку.</p>
    </div>
    <div class="flex flex-col divide-y divide-line border-y border-line">
      {faq.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-medium">
            {f.q}
            <span class="grid size-9 shrink-0 place-items-center rounded-full border border-line transition group-open:rotate-45 group-open:bg-ink group-open:text-white"><Icon name="plus" class="size-4" /></span>
          </summary>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
