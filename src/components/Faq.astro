---
import Icon from './Icon.astro';
const faq = [
  { q: 'Сколько длится монтаж?', a: 'Обычная квартира — один день. Сложные многоуровневые конструкции и световые линии — 2–3 дня.' },
  { q: 'Нужно ли выносить мебель?', a: 'Нет. Достаточно освободить доступ к стенам — мебель мы сдвигаем и укрываем плёнкой.' },
  { q: 'Есть ли запах после установки?', a: 'Используем сертифицированные полотна. Лёгкий запах, если появится, уходит за 1–2 дня проветривания.' },
  { q: 'Выдержит ли потолок затопление соседями?', a: 'Да, ПВХ-полотно держит до 100 литров воды на м². Мы приедем и сольём воду, потолок вернётся в исходный вид.' },
  { q: 'Как формируется цена и может ли она вырасти?', a: 'Точную стоимость считает замерщик на месте и фиксирует в договоре. После монтажа цена не меняется.' },
  { q: 'Какая гарантия?', a: 'Гарантия на полотно и на монтажные работы прописывается в договоре.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<section class="py-16 sm:py-24">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <p class="eyebrow">Вопросы</p>
      <h2 class="h2 mt-3">Частые вопросы</h2>
      <p class="mt-4 max-w-sm text-muted">Не нашли ответ? Позвоните или оставьте заявку — проконсультируем бесплатно.</p>
    </div>
    <div class="flex flex-col divide-y divide-line border-y border-line">
      {faq.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-medium">
            {f.q}
            <span class="grid size-9 shrink-0 place-items-center rounded-full border border-line transition group-open:rotate-45 group-open:bg-ink group-open:text-white"><Icon name="plus" class="size-4" /></span>
          </summary>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
