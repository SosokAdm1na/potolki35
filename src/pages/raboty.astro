---
import Layout from '../layouts/Layout.astro';
import Works from '../components/Works.astro';
import CtaForm from '../components/CtaForm.astro';
import { site } from '../config';
---
<Layout title={`Наши работы — натяжные потолки в Череповце, фото | ${site.name}`} description="Фото натяжных потолков, установленных нашей командой в Череповце: квартиры, дома, коммерческие помещения.">
  <section class="pt-10 sm:pt-16">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">Портфолио</p>
      <h1 class="mt-4 text-4xl font-medium sm:text-6xl">Наши работы</h1>
      <p class="mt-5 text-lg text-muted">Реальные объекты в Череповце и районе. Площадь, тип потолка и сроки — у каждого проекта.</p>
    </div>
  </section>
  <Works limit={100} showLink={false} />
  <CtaForm source="Страница работ" title="Хотите так же? Замер — бесплатно" />
</Layout>
