---
import Layout from '../layouts/Layout.astro';
import Works from '../components/Works.astro';
import CtaForm from '../components/CtaForm.astro';
import { site } from '../config';
---
<Layout title={`Наши работы — натяжные потолки в Череповце, фото | ${site.name}`} description="Фото натяжных потолков в Череповце: квартиры, дома, коммерческие помещения.">
  <section class="pb-8 pt-10 sm:pb-12 sm:pt-16">
    <div class="container-x">
      <p class="eyebrow">Портфолио <span class="ml-2 rounded-full bg-glow/30 px-2 py-0.5 text-[10px] tracking-normal text-ink normal-case">фото-заглушки</span></p>
      <h1 class="mt-4 max-w-3xl text-4xl font-medium sm:text-[56px] sm:leading-[1.08]">Наши работы</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">Квартиры, дома и коммерческие помещения в Череповце и районе.</p>
    </div>
  </section>
  <Works limit={100} bare />
  <CtaForm source="Страница работ" />
</Layout>
