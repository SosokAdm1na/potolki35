---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import CtaForm from '../components/CtaForm.astro';
import { site, prices } from '../config';
import { services } from '../data/services';
const fmt = (n: number) => n.toLocaleString('ru-RU') + ' ₽';
const extras = [
  ['Установка точечного светильника', fmt(prices.spotlight), 'шт'],
  ['Установка люстры', 'от ' + fmt(prices.chandelier), 'шт'],
  ['Световая линия', fmt(prices.lightLine), 'пог. м'],
  ['Обход трубы', fmt(prices.pipe), 'шт'],
  ['Скрытый карниз ПК-14', 'от ' + fmt(prices.hiddenCornice), 'пог. м'],
  ['Гардина в ванную АМ-1', 'от ' + fmt(prices.bathCurtain), 'пог. м'],
  ['Теневой профиль', fmt(prices.profile.shadow.perM), 'пог. м'],
  ['Парящий профиль с подсветкой', fmt(prices.profile.floating.perM), 'пог. м'],
];
---
<Layout title={`Цены на натяжные потолки в Череповце 2026 — калькулятор | ${site.name}`} description="Цены на натяжные потолки в Череповце с монтажом. Онлайн-калькулятор стоимости, прайс на светильники и профили. Скидка по заявке с сайта.">
  <section class="pb-10 pt-10 sm:pb-14 sm:pt-16">
    <div class="container-x">
      <p class="eyebrow">Прайс</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-medium sm:text-[56px] sm:leading-[1.08]">Цены на натяжные потолки</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">Стоимость с материалами и работой. Точную смету замерщик составит бесплатно.</p>
    </div>
  </section>

  <Calculator heading={false} />

  <section class="sec">
    <div class="container-x grid gap-4 lg:grid-cols-2">
      <div class="rounded-4xl border border-line bg-surface p-6 sm:p-8">
        <h2 class="text-2xl font-medium">Полотна с монтажом</h2>
        <table class="mt-6 w-full text-left">
          <tbody class="divide-y divide-line">
            {services.map((s) => (
              <tr><td class="py-3.5"><a href={`/potolki/${s.slug}/`} class="hover:underline">{s.title}</a></td><td class="py-3.5 text-right font-semibold whitespace-nowrap">{s.price}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="rounded-4xl border border-line bg-surface p-6 sm:p-8">
        <h2 class="text-2xl font-medium">Свет и дополнительные работы</h2>
        <table class="mt-6 w-full text-left">
          <tbody class="divide-y divide-line">
            {extras.map(([t, p, u]) => (
              <tr><td class="py-3.5 pr-4">{t}</td><td class="py-3.5 text-right font-semibold whitespace-nowrap">{p}<span class="font-normal text-muted"> / {u}</span></td></tr>
            ))}
          </tbody>
        </table>
        <p class="mt-6 text-sm text-muted">Минимальная сумма заказа — {fmt(prices.minOrder)}.</p>
      </div>
    </div>
  </section>
  <CtaForm source="Страница цен" />
</Layout>
