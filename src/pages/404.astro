---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
---
<Layout title={`Страница не найдена | ${site.name}`} description="Страница не найдена">
  <section class="py-24 text-center">
    <div class="container-x">
      <p class="font-display text-8xl font-medium text-line">404</p>
      <h1 class="mt-4 text-3xl font-medium">Такой страницы нет</h1>
      <p class="mt-3 text-muted">Возможно, ссылка устарела.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn-primary">На главную</a>
        <a href="/ceny/" class="btn-ghost">Калькулятор</a>
      </div>
    </div>
  </section>
</Layout>
