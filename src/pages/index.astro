---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Calculator from '../components/Calculator.astro';
import Works from '../components/Works.astro';
import Steps from '../components/Steps.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaForm from '../components/CtaForm.astro';
import { site, prices } from '../config';
---
<Layout
  title={`Натяжные потолки в Череповце под ключ — от ${prices.canvas.matte.perM2} ₽/м² | ${site.name}`}
  description={`Натяжные потолки ${site.cityIn}: матовые, парящие, теневые, световые линии. Бесплатный замер, монтаж за 1 день, скидка ${site.discountPercent}% по заявке с сайта.`}
>
  <!-- Первый экран -->
  <section class="pb-10 pt-8 sm:pb-14 sm:pt-12">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-12">
        <div>
          <p class="eyebrow mb-4 sm:mb-5">{site.city}</p>
          <h1 class="text-[36px] leading-[1.08] font-medium sm:text-[52px] lg:text-[46px] xl:text-[56px]">Натяжной потолок за&nbsp;1&nbsp;день</h1>
        </div>
        <div class="flex flex-col gap-5 lg:w-[452px] lg:pb-1">
          <p class="text-lg leading-snug text-balance text-muted">Закажите бесплатный замер, рассчитав примерную стоимость</p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href="#calc" class="btn-primary !py-4 whitespace-nowrap"><Icon name="calc" /> Рассчитать стоимость</a>
            <button type="button" class="btn-ghost !py-4 whitespace-nowrap" data-open-lead data-lead-source="Первый экран">Заказать замер</button>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-8 sm:mt-12">
      <HeroCarousel />
    </div>
  </section>

  <!-- Коротко об условиях -->
  <section class="relative bg-surface">
    <div class="light-rule line-draw absolute inset-x-0 top-0"></div>
    <div class="container-x grid grid-cols-2 gap-x-4 gap-y-6 py-7 sm:py-9 lg:grid-cols-4 lg:gap-x-8">
      {[
        ['ruler', 'Замер бесплатно', 'по городу и району'],
        ['clock', 'Монтаж за 1 день', 'в обычной квартире'],
        ['ruble', 'Цена с монтажом', 'материалы и работа'],
        ['shield', 'Работаем по договору', 'с гарантией'],
      ].map(([i, t, d]) => (
        <div class="flex items-center gap-2.5 sm:gap-3">
          <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-paper sm:size-11 sm:rounded-2xl"><Icon name={i} class="size-5" /></span>
          <span class="min-w-0"><b class="block text-sm leading-tight font-semibold sm:text-base">{t}</b><span class="text-xs text-muted sm:text-sm">{d}</span></span>
        </div>
      ))}
    </div>
  </section>

  <ServiceGrid />
  <Calculator />
  <Works />
  <Steps />
  <Reviews />
  <Faq />
  <CtaForm />
</Layout>
